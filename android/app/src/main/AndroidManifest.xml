<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 网络权限（Phase 3.6 补）：
         Flutter 模板只在 src/debug 与 src/profile 的 manifest 里加了 INTERNET
         （那是给 hot reload 用的），**main 里没有** —— 也就是说 release APK
         默认没有网络权限，插件的 ctx.http 在正式包里会直接失败。
         插件的核心能力就是拉教务数据，所以必须在 main 里声明。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 添加桌面快捷方式 / 小部件（MIUI 系）：
         HyperOS 桌面在真正落桌面之前会检查 `Utilities.hasAddShortcutPermission`，
         它读的是小米自定义 app-op **MIUIOP(10017)**（OP_INSTALL_SHORTCUT，
         反编译 com.miui.home 得到：AppOpsManagerUtils.noteOpNoThrow(10017, uid, pkg)）。
         这个 op 对"从来没声明过快捷方式能力"的三方包默认是 ignore，
         结果是：系统 pin 请求走到桌面 → 弹/不弹确认都无所谓 →
         最后一步被拦成 "add widget failed, <pkg> has no permission"（真机 logcat 原文）。
         声明这条 AOSP 早已废弃的 normal 级权限后该 op 变为 allow，链路才能走通。 -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT"/>
    <!-- 校外扫码登录：把 CAS 二维码写进系统相册，供微信「扫一扫 → 相册」识别。
         Android 10+ 走 MediaStore，不需要权限；只有 7–9 需要这条（maxSdkVersion=28）。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- ===== 作业提醒（Phase 9）=====
         1. POST_NOTIFICATIONS：Android 13+ 发通知必须运行时授权；
         2. SCHEDULE_EXACT_ALARM：Android 12+ 精确闹钟（用户可在系统里撤销，
            撤销后代码自动降级为不精确闹钟，仍会提醒、只是可能晚几分钟）；
         3. USE_EXACT_ALARM：本 App 属"用户可见的提醒"用途，声明后安装即授予
            精确闹钟能力（不依赖用户去系统设置里单独开）；
         4. RECEIVE_BOOT_COMPLETED：重启后重排闹钟（AlarmManager 不持久化，
            不重排就等于"重启一次手机，提醒永久失效"）；
         5. FOREGROUND_SERVICE(+DATA_SYNC)：到点时要起临时 Flutter 引擎去
            查作业状态，必须在前台服务里做（广播接收器只有 10s 预算）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- 网络安全配置（Phase 4.2.2）：只对白名单域名放行明文 HTTP。
         教务系统登录会从 https 重定向到 http，默认策略下会被拦成
         `net::ERR_CLEARTEXT_NOT_PERMITTED`。**没有**用 usesCleartextTraffic="true"
         ——那是全局放行。详见 res/xml/network_security_config.xml。 -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- 小米小部件版本号（小米《小部件技术规范》第 10 条要求，application 级，
             从 1 开始、有变动只能升不能降）。
             ⚠️ 2026-10-17 反编译取证后的正确理解（详见 docs/widget_task_breakdown.md 6.3）：
             它既不会让应用进 HyperOS 小部件中心，也不影响"添加到桌面"的 pin 链路。
             小部件中心的应用详情页内容来自小米云端目录
             （com.miui.personalassistant → PickerDetailRepository → 远端接口），
             本地声明不可能把未上架的小部件塞进那个列表。
             保留它只因为这是官方规范里的能力声明、无副作用；将来真做小米规范
             小部件（MAML）时才真正被读取。 -->
        <meta-data
            android:name="miuiWidgetVersion"
            android:value="1" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ============================================================
             小组件（Phase W1）：4 张标准 AppWidget 卡片。

             ⚠️⚠️ 2026-10-17 根因修复：**不要再给这 4 个 receiver 加"小米三件套"**
             （miuiWidget meta-data / miui.appwidget.action.APPWIDGET_UPDATE 动作 /
             android:process=":widgetProvider"）。曾经的 W5"真机修复"加了它们，
             当天真机表现是"应用内点添加 → 返回值 true 但桌面毫无反应"，
             根因由反编译 HyperOS 桌面（com.miui.home RELEASE-7.50.06）确定：

                AddItemActivity.onCreate()
                  → 系统 pin 请求（requestPinAppWidget）落到这里的 requestType=2
                  → MIUIWidgetUtil.startWidgetDetailPage(activity, info, extras)
                       if (bundle == null || !isMIUIWidgetSupport()) return false;
                       if (!isMIUIWidget(activity, info.provider)) return false;   // ← 读的就是 miuiWidget
                       startActivity(widget://picker/detail?packageName=...);      // ← 小米云端目录详情页
                       return true;
                  → 返回 true 时 AddItemActivity 直接 finish()，
                    标准的"是否添加小组件"确认弹窗被跳过

             也就是说：声明 miuiWidget=true 会把我们伪装成"小米规范小部件"，
             系统 pin 因而被改道去打开小部件中心的应用详情页；而那个页面是云端
             目录（PickerDetailRepository.getPickerData → PickerDetailService 远端
             接口）驱动，未上架的应用只会看到空页面/"正在努力适配中"。
             结果就是：既进不了小部件中心，又拿不到标准确认弹窗 → 用户"找不到小组件"。

             去掉这三项后 isMIUIWidget() 为 false → startWidgetDetailPage 返回 false
             → 回落到标准的 showPinWidgetConfirmDialog() → 用户确认后由
             InstallWidgetReceiver 真正把卡片绑到桌面。三个改动一起去掉，缺一不可。
             ============================================================ -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:label="@string/widget_label_today"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_today" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:label="@string/widget_label_week"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_week" />
        </receiver>

        <receiver
            android:name=".widget.HomeworkWidgetProvider"
            android:label="@string/widget_label_homework"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_homework" />
        </receiver>

        <receiver
            android:name=".widget.ExamWidgetProvider"
            android:label="@string/widget_label_exam"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_exam" />
        </receiver>

        <!-- pin（添加到桌面）请求的结果回调：
             requestPinAppWidget 的 successCallback 是 PendingIntent，
             桌面真正把卡片加进工作区后才会发出，里面带 EXTRA_APPWIDGET_ID。
             用来区分"已加进桌面"和"用户取消 / 桌面不支持"，把结果告诉 Dart。
             exported=false：只有持有我们给的 PendingIntent 的系统/桌面能发。 -->
        <receiver
            android:name=".widget.WidgetPinResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zys.myschedule.action.WIDGET_PIN_RESULT" />
            </intent-filter>
        </receiver>

        <!-- ===== 作业提醒（Phase 9）=====
             闹钟 → 广播 → 前台校验服务（起临时引擎查作业状态）→ 通知。
             exported=false：只有本应用自己的 PendingIntent 能触发。 -->
        <receiver
            android:name=".reminder.HomeworkReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zys.myschedule.action.HOMEWORK_REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 覆盖安装后重排闹钟。exported=true 是系统广播的要求
             （BOOT_COMPLETED 由系统进程发送）。 -->
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 校验服务：前台服务类型 dataSync（Android 14+ 必须显式声明类型）。
             dataSync 是"短时数据同步"语义，与"查一次作业状态"完全吻合。 -->
        <service
            android:name=".reminder.HomeworkReminderFireService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 包可见性：二维码桥要判断微信是否安装、并拉起
             weixin://dl/scan。不声明的话 getPackageInfo / startActivity 会被拦。 -->
        <package android:name="com.tencent.mm"/>
    </queries>
</manifest>
