<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 平台网络安全配置（Phase 4.2.2）。

  作用：**定向白名单**，只允许指定域名的明文 HTTP 流量。
  targetSdk 34 起 Android 默认禁止 cleartext（明文 HTTP），而 NCST 教务系统
  登录时会从 https 重定向到 http://xjw1.ncst.edu.cn/gotoLogin，
  被系统拦掉的表现就是 WebView 报 `-1 net::ERR_CLEARTEXT_NOT_PERMITTED`
  （插件侧走 dio 的 ctx.http 同样会被拦——dio 用的是系统网络策略）。

  ⚠️ **学习通（Phase 8 真机实测追加）**：超星学习通同样会走明文 HTTP——
  登录成功后 302 跳到 `http://i.mooc.chaoxing.com/`（**注意是 http**），
  真机上报的就是 `-1 net::ERR_CLEARTEXT_NOT_PERMITTED`，表现是
  「登录后页面显示加载失败」。这与"学习通全是 https"的推测相反，
  是**只有真机才暴露得出来**的问题（桌面浏览器不会套用 Android 的网络策略）。
  故下面为 `chaoxing.com` 整域（含子域）放行。

  ⚠️ 与 CONTEXT 3.1 的关系（已在 CONTEXT.md 3.1 末尾写明为例外）：
  本文件是**平台安全策略配置**，不是业务逻辑代码；这里出现的域名是
  "允许明文流量的域名白名单"，与"内核不得硬编码学校 URL / 字段名 / 接口路径"
  并不冲突（内核代码里依然一个学校 URL 都没有，见 `grep -r "ncst\|xjw1" lib/`）。

  ⚠️ 维护成本：每新增一个使用 http 的学校，都要在此追加一条 <domain-config>
  并**重新发版**（这是系统级配置，插件无法在运行时改）。
  如需免发版，只能全局 usesCleartextTraffic="true" —— **不采用**，那是全局降级。
-->
<network-security-config>
    <!-- 默认禁止明文流量（保持 Android 默认的安全策略） -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 定向放行：教务系统登录会重定向到 http，必须允许 -->
    <!-- 每新增一个使用 http 的学校，在此追加一条 domain-config -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">xjw1.ncst.edu.cn</domain>
    </domain-config>

    <!-- 学习通（超星）：登录后 302 到 http://i.mooc.chaoxing.com/，真机实测被拦。
         用整域放行而不是逐个列主机，是因为学习通会在
         passport2 / i.mooc / i / mooc1-2 等多台主机间跳转，
         逐个列会漏；这些主机同属一个服务方，信任级别一致。
         仍**不是**全局放行（base-config 保持 false）。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">chaoxing.com</domain>
    </domain-config>

    <!-- 物理实验中心（大物实验选课系统）：整站是 **http + 非标准端口 8100**
         （http://phylab.ncst.edu.cn:8100），既没有 https 也没有证书可用。
         不放行的话，插件详情页点「登录」时 WebView 会直接报
         `net::ERR_CLEARTEXT_NOT_PERMITTED`——页面根本没发出去。
         注意：`domain-config` 只管域名，端口不参与匹配，8100 不需要单独写。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">phylab.ncst.edu.cn</domain>
    </domain-config>
</network-security-config>
