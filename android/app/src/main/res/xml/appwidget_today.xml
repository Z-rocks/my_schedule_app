<?xml version="1.0" encoding="utf-8"?>
<!-- 下一节课：2×2，四向可缩放（宽卡拉成 2×4 平板用）。
     只渲染当前/下一节课（课程名 + 节次时间 + 地点 + 状态），
     今天完整课程列表由 appwidget_week（今日课程）承担。
     previewImage 必须给：HyperOS/MIUI 小部件中心靠预览图渲染卡片入口，
     没有 previewImage 的 provider 会被列表直接过滤掉（真机实测）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/widget_label_today"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:previewImage="@drawable/widget_preview_today"
    android:description="@string/widget_label_today"
    android:widgetCategory="home_screen" />
