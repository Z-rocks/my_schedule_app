<?xml version="1.0" encoding="utf-8"?>
<!-- 近期考试列表的一行（最近一场之后的其余考试） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/widget_hw_row_padding_vertical"
    android:paddingBottom="@dimen/widget_hw_row_padding_vertical">

    <TextView
        android:id="@+id/exam_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_exam_row_name_text" />

    <TextView
        android:id="@+id/exam_row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_exam_row_meta_text" />

    <TextView
        android:id="@+id/exam_row_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_exam_row_days_text" />
</LinearLayout>
